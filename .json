{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 10
    },
    "separator": ""
  },
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#ccccff"
    },
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "modules": [
    "break",
{
      "type": "title",
      "key": " USER",
      "keyColor": "#ccccff",
      "color": {
        "user": "white",
        "at": "white",
        "host": "white"
      },
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#c6d2ff",
      "format": "{pretty-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m──────────────────────────────────────\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "󰆍 TERM",
      "keyColor": "#c1d7ff",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": " SH",
      "keyColor": "#c0d9ff",
      "format": "{pretty-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m──────────────────────────────────────\u001b[0m"
    },
    {
      "type": "board",
      "key": "󰍹 MB",
      "keyColor": "#bcd8ff",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "#bddeff",
      "format": "{used} / {total} ({percentage})"
    },
        {
      "type": "disk",
      "folders": "/",
      "key": "󰋊 SSD",
      "keyColor": "#bde0fe",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#c2d5ff",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󱛟 GPU",
      "keyColor": "#bfdaff",
      "format": "{name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m──────────────────────────────────────\u001b[0m"
    },
    {
      "type": "localip",
      "key": " IP",
      "keyColor": "#bbdcff",
      "format": "{ipv4}"
    },
    {
      "type": "uptime",
      "keyColor": "#bedcff",
      "key": "󰥔 UP"
    },
    {
      "type": "datetime",
      "key": " TIME",
      "keyColor": "#b9deff",
      "shell": "bash",
      "text": "{1}/{8}/{11} {14}:{17}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m \u001b[91m \u001b[92m \u001b[93m \u001b[94m \u001b[95m \u001b[96m \u001b[97m"
    },
    "break"
  ]
}